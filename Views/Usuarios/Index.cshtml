@model List<HikariLegalSRL.ViewModels.Usuarios.UsuarioListaViewModel>

@{
    ViewData["Title"] = "Usuarios";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold usuarios-titulo">Usuarios</h4>
    <a asp-controller="Usuarios" asp-action="Crear" class="btn text-white usuarios-btn-nuevo">
        <i class="bi bi-plus-lg me-1"></i>Nuevo usuario
    </a>
    <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-shield-lock me-1"></i>Gestionar roles
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-3">Nombre</th>
                    <th>Correo</th>
                    <th>Rol</th>
                    <th>Especialidad</th>
                    <th>Estado</th>
                    <th class="text-end pe-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td class="ps-3">@usuario.NombreCompleto</td>
                        <td>@usuario.Correo</td>
                        <td>@usuario.Rol</td>
                        <td>@(usuario.Especialidad ?? "—")</td>
                        <td>
                            @if (usuario.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                        <td class="text-end pe-3">
                            <a asp-controller="Usuarios" asp-action="Editar" asp-route-id="@usuario.Id"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>