@model HikariLegalSRL.ViewModels.CreateUserViewModel

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="d-flex align-items-center mb-4">
    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0 fw-bold" style="color:#1f3864;">Nuevo Usuario</h4>
</div>

<div class="card shadow-sm border-0" style="max-width: 700px">
    <div class="card-body p-4">
        <form asp-controller="Usuarios" asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
                <input asp-for="NombreCompleto" class="form-control" autocomplete="off" />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label fw-semibold"></label>
                <input asp-for="Correo" class="form-control" autocomplete="off" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Contrasena" class="form-label fw-semibold"></label>
                    <input asp-for="Contrasena" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Contrasena" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmarContrasena" class="form-label fw-semibold"></label>
                    <input asp-for="ConfirmarContrasena" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmarContrasena" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RolId" class="form-label fw-semibold">Rol</label>
                    <select asp-for="RolId" asp-items="Model.RolesDisponibles" class="form-select">
                        <option value="">-- Seleccione un rol --</option>
                    </select>
                    <span asp-validation-for="RolId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Especialidad" class="form-label fw-semibold"></label>
                    <input asp-for="Especialidad" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Especialidad" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary">
                    Cancelar
                </a>
                <button type="submit" class="btn text-white" style="background:#1D6A3A;">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
            </div>

        </form>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
