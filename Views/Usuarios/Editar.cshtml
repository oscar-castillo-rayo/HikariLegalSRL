@model HikariLegalSRL.ViewModels.Usuarios.EditarUsuarioViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

@section Styles {
    <link rel="stylesheet" href="~/css/usuarios.css" />
}

<div class="d-flex align-items-center mb-4">
    <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0 fw-bold usuarios-titulo">
        Editar Usuario
    </h4>
</div>

<div class="card shadow-sm border-0 usuarios-card-form">
    <div class="card-body p-4">
        <form asp-controller="Usuarios" asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label fw-semibold"></label>
                <input asp-for="NombreCompleto" class="form-control" autocomplete="off" />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label fw-semibold"></label>
                <input asp-for="Correo" class="form-control" autocomplete="off" />
                <span asp-validation-for="Correo" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="RolId" class="form-label fw-semibold">Rol</label>
                    <select asp-for="RolId" asp-items="Model.RolesDisponibles" class="form-select">
                        <option value="">-- Seleccione un rol --</option>
                    </select>
                    <span asp-validation-for="RolId" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Especialidad" class="form-label fw-semibold"></label>
                    <input asp-for="Especialidad" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Especialidad" class="text-danger small"></span>
                </div>
            </div>

            <div class="col-12">
                <div class="p-3 rounded-3" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                    <div class="form-check form-switch mb-0 d-flex align-items-center">
                        <input asp-for="Activo" class="form-check-input fs-5 mt-0 me-3" role="switch" style="cursor: pointer;" id="ActivoSwitch" />
                        <div>
                            <label asp-for="Activo" class="form-check-label fw-bold mb-0" for="ActivoSwitch" style="cursor: pointer; color: #1f3864;"></label>
                            <div class="small text-muted">Habilita o deshabilita este usuario en el sistema.</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-danger">
                    Cancelar
                </a>
                <button type="submit" class="btn text-white usuarios-btn-nuevo">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}