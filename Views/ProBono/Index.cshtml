@model List<HikariLegalSRL.Models.DTOs.SolicitudProBonoListaDTO>
@using HikariLegalSRL.Models.Enums

@{
    ViewData["Title"] = "Pro Bono";
}

@section Styles {
    <link rel="stylesheet" href="~/css/probono.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h4 class="mb-0 fw-bold probono-titulo"><i class="bi bi-heart me-2"></i>Pro Bono</h4>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nueva solicitud
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 probono-tabla">
            <thead>
                <tr>
                    <th>Beneficiario</th>
                    <th>Solicitado por</th>
                    <th>Justificación</th>
                    <th class="text-center">Estado</th>
                    <th>Fecha</th>
                    <th>Resuelto por</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No hay solicitudes pro bono registradas.
                        </td>
                    </tr>
                }
                @foreach (var s in Model)
                {
                    var (bc, bt) = s.Decision switch
                    {
                        DecisionProBono.Pendiente => ("warning text-dark", "Pendiente"),
                        DecisionProBono.Aprobada => ("success", "Aprobada"),
                        DecisionProBono.Rechazada => ("danger", "Rechazada"),
                        _ => ("secondary", s.Decision.ToString())
                    };
                    <tr>
                        <td class="fw-semibold">@s.Beneficiario</td>
                        <td><small>@s.SolicitanteNombre</small></td>
                        <td>
                            <small class="text-muted">
                                @(s.JustificacionEscrita.Length > 80 ? s.JustificacionEscrita[..80] + "…" : s.JustificacionEscrita)
                            </small>
                        </td>
                        <td class="text-center"><span class="badge bg-@bc">@bt</span></td>
                        <td><small>@s.FechaSolicitud.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
                        <td><small>@(s.ResueltoPorNombre ?? "—")</small></td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary" title="Ver solicitud">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
