@model HikariLegalSRL.ViewModels.Servicios.ServicioEditViewModel
@using HikariLegalSRL.Models.Enums

@{
    ViewData["Title"] = "Editar servicio";
}

@section Styles {
    <link rel="stylesheet" href="~/css/servicios.css" />
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0 fw-bold servicios-titulo">Editar servicio</h4>
</div>

<div class="card shadow-sm border-0 servicios-form-card">
    <div class="card-body p-3 p-md-4">
        <form asp-action="Editar" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Servicio.Nombre" class="form-label fw-semibold"></label>
                    <input asp-for="Servicio.Nombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Servicio.Nombre" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Servicio.AreaCategoria" class="form-label fw-semibold">Área / Categoría</label>
                    <input asp-for="Servicio.AreaCategoria" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Servicio.AreaCategoria" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Servicio.PrecioBase" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <span class="input-group-text">₡</span>
                        <input asp-for="Servicio.PrecioBase" class="form-control" type="number" step="0.01" />
                    </div>
                    <span asp-validation-for="Servicio.PrecioBase" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Servicio.Descripcion" class="form-label fw-semibold"></label>
                    <textarea asp-for="Servicio.Descripcion" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Servicio.Descripcion" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Servicio.TipoServicio" class="form-label fw-semibold">Tipo</label>
                    <select asp-for="Servicio.TipoServicio" class="form-select">
                        <option value="">-- Seleccione --</option>
                        <option value="@TipoServicio.Ofrecido">Ofrecido por la firma</option>
                        <option value="@TipoServicio.Solicitado">Solicitado por el cliente</option>
                    </select>
                    <span asp-validation-for="Servicio.TipoServicio" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-sm-end gap-2 mt-4">
                <a asp-action="Index" class="btn btn-outline-danger order-2 order-sm-1">Cancelar</a>
                <button type="submit" class="btn text-white fw-semibold px-4 order-1 order-sm-2 servicios-btn-guardar">
                    <i class="bi bi-check-lg me-1"></i>Guardar cambios
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
