@model HikariLegalSRL.ViewModels.Auditoria.AuditoriaIndexViewModel

@{
    ViewData["Title"] = "Bitácora de Auditoría";

    var acciones = new[]
    {
        (Valor: "crear", Etiqueta: "Crear", Color: "text-bg-success"),
        (Valor: "editar", Etiqueta: "Editar", Color: "text-bg-primary"),
        (Valor: "eliminar", Etiqueta: "Eliminar", Color: "text-bg-danger"),
        (Valor: "cambiar_estado", Etiqueta: "Cambiar estado", Color: "text-bg-warning"),
        (Valor: "aprobar", Etiqueta: "Aprobar", Color: "text-bg-info"),
        (Valor: "rechazar", Etiqueta: "Rechazar", Color: "text-bg-secondary")
    };

    var filtro = Model.Filtro;
    var resultado = Model.Resultado;

    var primeraPagina = Math.Max(1, resultado.Pagina - 2);
    var ultimaPagina = Math.Min(resultado.TotalPaginas, primeraPagina + 4);
    primeraPagina = Math.Max(1, ultimaPagina - 4);

    var rutaFiltro = new Dictionary<string, string?>
    {
        ["UsuarioId"] = filtro.UsuarioId,
        ["TipoAccion"] = filtro.TipoAccion,
        ["Desde"] = filtro.Desde?.ToString("yyyy-MM-ddTHH:mm"),
        ["Hasta"] = filtro.Hasta?.ToString("yyyy-MM-ddTHH:mm")
    };

    Dictionary<string, string?> RutaPagina(int pagina)
    {
        var ruta = new Dictionary<string, string?>(rutaFiltro) { ["Pagina"] = pagina.ToString() };
        return ruta;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/auditoria.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h4 class="mb-0 fw-bold auditoria-titulo"><i class="bi bi-journal-text me-2"></i>Bitácora de Auditoría</h4>
    <span class="text-muted small">@resultado.Total registro(s) encontrado(s)</span>
</div>

<form method="get" class="card p-3 mb-4 shadow-sm">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Usuario</label>
            <select name="UsuarioId" class="form-select">
                <option value="">Todos</option>
                @foreach (var usuario in Model.Usuarios)
                {
                    <option value="@usuario.Id" selected="@(filtro.UsuarioId == usuario.Id)">@usuario.Nombre</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-semibold">Tipo de acción</label>
            <select name="TipoAccion" class="form-select">
                <option value="">Todas</option>
                @foreach (var accion in acciones)
                {
                    <option value="@accion.Valor" selected="@(filtro.TipoAccion == accion.Valor)">@accion.Etiqueta</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Desde</label>
            <input type="datetime-local" name="Desde" class="form-control" value="@filtro.Desde?.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-semibold">Hasta</label>
            <input type="datetime-local" name="Hasta" class="form-control" value="@filtro.Hasta?.ToString("yyyy-MM-ddTHH:mm")" />
        </div>
        <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-outline-secondary flex-grow-1">
                <i class="bi bi-search me-1"></i>Filtrar
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary" title="Quitar filtros">
                <i class="bi bi-x-lg"></i>
            </a>
        </div>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 auditoria-tabla">
            <thead>
                <tr>
                    <th>Fecha y hora</th>
                    <th>Usuario</th>
                    <th>Entidad</th>
                    <th class="text-center">Acción</th>
                    <th>Valor anterior</th>
                    <th>Valor nuevo</th>
                    <th class="text-end">Detalle</th>
                </tr>
            </thead>
            <tbody>
                @if (resultado.Registros.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            No hay registros de auditoría con los filtros aplicados.
                        </td>
                    </tr>
                }
                @foreach (var r in resultado.Registros)
                {
                    var accion = acciones.FirstOrDefault(a => a.Valor == r.TipoAccion);
                    <tr>
                        <td><small>@r.FechaHora.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</small></td>
                        <td><small>@r.UsuarioNombre</small></td>
                        <td>
                            <span class="badge bg-secondary">@r.ModuloAfectado</span>
                            <small class="text-muted">#@r.RegistroAfectadoId</small>
                        </td>
                        <td class="text-center">
                            <span class="badge @(accion.Color ?? "text-bg-secondary")">@(accion.Etiqueta ?? r.TipoAccion)</span>
                        </td>
                        <td class="auditoria-valor">
                            <small class="text-muted">@(string.IsNullOrWhiteSpace(r.ValorAnteriorResumen) ? "—" : r.ValorAnteriorResumen.TrimEnd() + (r.ValorAnteriorTieneMas ? "…" : ""))</small>
                        </td>
                        <td class="auditoria-valor">
                            <small class="text-muted">@(string.IsNullOrWhiteSpace(r.ValorNuevoResumen) ? "—" : r.ValorNuevoResumen.TrimEnd() + (r.ValorNuevoTieneMas ? "…" : ""))</small>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary" title="Ver registro completo">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (resultado.TotalPaginas > 1)
{
    <nav class="mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2" aria-label="Paginación de la bitácora">
        <small class="text-muted">Página @resultado.Pagina de @resultado.TotalPaginas</small>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(resultado.Pagina == 1 ? "disabled" : null)">
                <a class="page-link" asp-action="Index" asp-all-route-data="RutaPagina(resultado.Pagina - 1)" aria-label="Anterior">&laquo;</a>
            </li>
            @for (var p = primeraPagina; p <= ultimaPagina; p++)
            {
                <li class="page-item @(p == resultado.Pagina ? "active" : null)">
                    <a class="page-link" asp-action="Index" asp-all-route-data="RutaPagina(p)">@p</a>
                </li>
            }
            <li class="page-item @(resultado.Pagina == resultado.TotalPaginas ? "disabled" : null)">
                <a class="page-link" asp-action="Index" asp-all-route-data="RutaPagina(resultado.Pagina + 1)" aria-label="Siguiente">&raquo;</a>
            </li>
        </ul>
    </nav>
}

<p class="text-muted small mt-3 mb-0">
    <i class="bi bi-shield-lock me-1"></i>
    La bitácora es inalterable: ningún usuario puede editar ni eliminar sus registros. Las fechas y horas son locales y "Hasta" incluye ese minuto completo. Para ver un día completo, usa de 12:00 a. m. a 11:59 p. m.
</p>
