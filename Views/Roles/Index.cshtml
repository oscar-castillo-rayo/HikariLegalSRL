@model List<HikariLegalSRL.ViewModels.Roles.RolListaViewModel>

@{
    ViewData["Title"] = "Roles";
}
@section Styles {
    <link rel="stylesheet" href="~/css/roles.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0 fw-bold" style="color:#1f3864;">Roles</h4>
    <a asp-controller="Roles" asp-action="Crear" class="btn text-white" style="background:#1D6A3A;">
        <i class="bi bi-plus-lg me-1"></i>Nuevo rol
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <div class="table-responsive">
                    <thead>
                        <tr>
                            <th class="ps-3">Nombre</th>
                            <th class="d-none d-md-table-cell">Descripción</th>
                            <th>Estado</th>
                            <th class="text-end pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rol in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @rol.Nombre
                                    @if (rol.EsFijo)
                                    {
                                        <span class="badge bg-secondary ms-1">Fijo</span>
                                    }
                                </td>
                                <td class="d-none d-md-table-cell text-wrap description-role">@(rol.Descripcion ?? "—")</td>
                                <td>
                                    @if (rol.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-3">
                                    @if (!rol.EsFijo)
                                    {
                                        <a asp-controller="Roles" asp-action="Editar" asp-route-id="@rol.Id"
                                           class="btn btn-outline-secondary btn-sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>