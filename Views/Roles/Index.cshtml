@model HikariLegalSRL.ViewModels.Roles.GestionarPermisosViewModel

@{
    ViewData["Title"] = "Roles y Permisos";
}

@section Styles {
    <link rel="stylesheet" href="~/css/roles.css" />
}

<div class="d-flex justify-content-between align-items-center m-2 mb-lg-4">
    <div class="d-flex">
        <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h4 class="mb-0 fw-bold roles-titulo">Roles y Permisos</h4>
    </div>
    <a asp-controller="Roles" asp-action="Crear" class="btn text-white roles-btn-nuevo">
        <i class="bi bi-plus-lg me-1"></i>Nuevo rol
    </a>
</div>

<div class="rp-layout">
    <div class="rp-panel">
        <div class="rp-panel-header">
            <h3>Roles del sistema</h3>
        </div>
        @foreach (var rol in Model.Roles)
        {
            <a asp-action="Index" asp-route-rolId="@rol.Id"
               class="rp-role-item @(Model.RolSeleccionado?.Id == rol.Id ? "active" : "")">
                <div class="rp-role-name">@rol.Nombre</div>
                <span class="badge @(rol.Activo ? "bg-success" : "bg-secondary") mt-1" style="font-size:10px;">
                    @(rol.Activo ? "Activo" : "Inactivo")
                </span>
            </a>
        }
    </div>

    <div class="rp-detail-wrapper">
        @if (Model.RolSeleccionado is null)
        {
            <div class="rp-detail">
                <p class="text-muted">No hay roles registrados todavía.</p>
            </div>
        }
        else
        {
            var rol = Model.RolSeleccionado;
            <form asp-controller="Roles" asp-action="GuardarPermisos" method="post" class="d-flex flex-column flex-grow-1">
                @Html.AntiForgeryToken()
                <input type="hidden" name="rolId" value="@rol.Id" />

                <div class="rp-detail">
                    <div class="rp-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                        <h2 class="mb-0">Datos del rol</h2>
                        @if (!rol.EsFijo)
                        {
                            <a asp-controller="Roles" asp-action="Editar" asp-route-id="@rol.Id"
                               class="btn btn-outline-secondary btn-sm">
                                <i class="bi bi-pencil"></i>
                            </a>
                        }
                    </div>
                    <div class="rp-fields">
                            <div class="rp-field">
                                <label>Nombre del rol</label>
                                <input type="text" value="@rol.Nombre" disabled />
                            </div>
                            <div class="rp-field">
                                <label>Estado</label>
                                <div>
                                    <span class="badge @(rol.Activo ? "bg-success" : "bg-secondary")">
                                        @(rol.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </div>
                            </div>
                            <div class="rp-field" style="grid-column:span 2;">
                                <label>Descripción</label>
                                <input type="text" value="@(rol.Descripcion ?? "—")" disabled />
                            </div>
                        </div>
                    </div>

                    <div class="rp-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="mb-0">Permisos asignados</h2>
                            <span class="rp-tag">
                                @rol.Modulos.SelectMany(m => m.Acciones).Count(a => a.Asignado) permiso(s) activo(s)
                            </span>
                        </div>

                        @foreach (var modulo in rol.Modulos)
                        {
                            <div class="rp-modulo-block">
                                <div class="rp-modulo-header">
                                    <span class="rp-modulo-name">@modulo.Nombre</span>
                                    <span class="rp-modulo-count">
                                        @modulo.Acciones.Count(a => a.Asignado)/@modulo.Acciones.Count
                                    </span>
                                </div>
                                <table class="rp-acciones-table">
                                    <thead>
                                        <tr>
                                            <th>Acción</th>
                                            <th style="width:90px;text-align:center;">Habilitado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var accion in modulo.Acciones)
                                        {
                                            <tr>
                                                <td>
                                                    <span class="rp-tag">@accion.Nombre</span>
                                                    <div class="rp-accion-desc">@accion.Descripcion</div>
                                                </td>
                                                <td style="text-align:center;">
                                                    <label class="rp-toggle">
                                                        <input type="checkbox" name="permisosSeleccionados"
                                                               value="@accion.Codigo"
                                                               checked="@(accion.Asignado ? "checked" : null)"
                                                               disabled="@(rol.EsFijo ? "disabled" : null)" />
                                                        <div class="rp-toggle-track"></div>
                                                        <div class="rp-toggle-thumb"></div>
                                                    </label>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>

                @if (!rol.EsFijo)
                {
                    <div class="rp-save-bar">
                        <button type="submit" class="btn text-white roles-btn-guardar">
                            <i class="bi bi-floppy me-1"></i>Guardar cambios
                        </button>
                    </div>
                }
            </form>
        }
    </div>
</div>