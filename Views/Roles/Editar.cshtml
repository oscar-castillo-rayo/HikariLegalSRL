@model HikariLegalSRL.ViewModels.Roles.EditarRolViewModel

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="d-flex align-items-center mb-4">
    <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0 fw-bold" style="color:#1f3864;">Editar Rol</h4>
</div>

<div class="card shadow-sm border-0" style="max-width: 700px">
    <div class="card-body p-4">
        <form asp-controller="Roles" asp-action="Editar" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label fw-semibold"></label>
                <input asp-for="Nombre" class="form-control" autocomplete="off" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label fw-semibold"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3" maxlength="500"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="col-12">
                <div class="p-3 rounded-3" style="background-color: #f8f9fa; border: 1px solid #e9ecef;">
                    <div class="form-check form-switch mb-0 d-flex align-items-center">
                        <input asp-for="Activo" class="form-check-input fs-5 mt-0 me-3" role="switch" style="cursor: pointer;" id="ActivoSwitch" />
                        <div>
                            <label asp-for="Activo" class="form-check-label fw-bold mb-0" for="ActivoSwitch" style="cursor: pointer; color: #1f3864;"></label>
                            <div class="small text-muted">Habilita o deshabilita este rol en el sistema.</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-controller="Roles" asp-action="Index" class="btn btn-outline-danger">
                    Cancelar
                </a>
                <button type="submit" class="btn text-white" style="background:#1D6A3A;">
                    <i class="bi bi-check-lg me-1"></i>Guardar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}