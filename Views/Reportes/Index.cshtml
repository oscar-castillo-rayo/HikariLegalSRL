@{
    ViewData["Title"] = "Reportes";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reportes.css" />
}

<h2 class="fw-bold mb-4 reportes-titulo"><i class="bi bi-bar-chart me-2"></i>Reportes</h2>

<div class="row g-3 row-cols-1 row-cols-md-3">
    @if (await Authorization.TienePermiso(User, Permisos.Reportes.Conversion))
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4 d-flex flex-column">
                    <div class="fs-2 mb-2">📈</div>
                    <h6 class="fw-bold">Tasa de Conversión de Propuestas</h6>
                    <p class="text-muted small flex-grow-1">
                        Propuestas enviadas vs. aceptadas por período.
                    </p>
                    <div>
                        <a asp-action="Conversion" class="btn btn-sm text-white fw-semibold px-4 reportes-btn">
                            Ver reporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4 d-flex flex-column">
                    <div class="fs-2 mb-2">🔄</div>
                    <h6 class="fw-bold">Conversión de Prospectos</h6>
                    <p class="text-muted small flex-grow-1">
                        Prospectos registrados, convertidos y descartados por período.
                    </p>
                    <div>
                        <a asp-action="ConversionProspectos" class="btn btn-sm text-white fw-semibold px-4 reportes-btn">
                            Ver reporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (await Authorization.TienePermiso(User, Permisos.Reportes.Ingresos))
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4 d-flex flex-column">
                    <div class="fs-2 mb-2">💰</div>
                    <h6 class="fw-bold">Ingresos por Servicio</h6>
                    <p class="text-muted small flex-grow-1">
                        Facturación desglosada por área de servicio y período.
                    </p>
                    <div>
                        <a asp-action="IngresosPorServicio" class="btn btn-sm text-white fw-semibold px-4 reportes-btn">
                            Ver reporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (await Authorization.TienePermiso(User, Permisos.Reportes.Geo))
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4 d-flex flex-column">
                    <div class="fs-2 mb-2">🗺️</div>
                    <h6 class="fw-bold">Distribución Geográfica</h6>
                    <p class="text-muted small flex-grow-1">
                        Clientes agrupados por país, provincia, cantón o distrito.
                    </p>
                    <div>
                        <a asp-action="DistribucionGeografica" class="btn btn-sm text-white fw-semibold px-4 reportes-btn">
                            Ver reporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (await Authorization.TienePermiso(User, Permisos.Reportes.Carga))
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4 d-flex flex-column">
                    <div class="fs-2 mb-2">👥</div>
                    <h6 class="fw-bold">Carga de Trabajo por Colaborador</h6>
                    <p class="text-muted small flex-grow-1">
                        Tareas pendientes, en proceso y vencidas de cada colaborador.
                    </p>
                    <div>
                        <a asp-action="CargaTrabajo" class="btn btn-sm text-white fw-semibold px-4 reportes-btn">
                            Ver reporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
    @if (await Authorization.TienePermiso(User, Permisos.Reportes.Servicios))
    {
        <div class="col">
            <div class="card shadow-sm h-100">
                <div class="card-body text-center p-4 d-flex flex-column">
                    <div class="fs-2 mb-2">📋</div>
                    <h6 class="fw-bold">Comparativo de Servicios</h6>
                    <p class="text-muted small flex-grow-1">
                        Servicios ofrecidos vs. solicitados en propuestas aceptadas.
                    </p>
                    <div>
                        <a asp-action="ComparativoServicios" class="btn btn-sm text-white fw-semibold px-4 reportes-btn">
                            Ver reporte
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
