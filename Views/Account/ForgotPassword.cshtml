@{
}

@model HikariLegalSRL.ViewModels.Auth.ForgotPasswordViewModel

@{
    // Ocultar el sidebar/topbar pero mantener el layout para preservar estilos
    ViewData["HideShell"] = true;
    ViewData["Title"] = "Recuperar contraseña";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forgotPassword.css" />
}

<div class="container pe-auto">
</div>
<div class="login-card bg-white">

    <div class="text-center pt-4">
        <img src="~/images/fulllogo.png"
             alt="Hikari Legal"
             style="max-width:220px; width:100%;" />
    </div>

    <div class="p-4">
        <h4 class="text-center fw-bold mb-3" style="color:#1F3864;">Recuperar contraseña</h4>
        <p class="text-muted small text-center mb-4">Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.</p>

        <form asp-action="ForgotPassword" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="correo@empresa.com"
                       autocomplete="username" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn w-100 text-white fw-bold mb-3"
                    style="background-color:#1F3864;">
                Enviar enlace
            </button>

            <div class="text-center">
                <a asp-action="Login" class="text-decoration-none small fw-bold" style="color: #1F3864;">Volver al inicio de sesión</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

