@model HikariLegalSRL.ViewModels.Auth.ResetPasswordViewModel

@{
    ViewData["HideShell"] = true;
    ViewData["Title"] = "Restablecer contraseña";
}
<div class="container min-vh-100 d-flex align-items-center">
    <div class="row w-100 justify-content-center">
        <div class="col-md-5">

            <h2 class="mb-4">Restablecer contraseña</h2>

            <form asp-action="ResetPassword" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="Email" type="hidden" />
                <input asp-for="Code" type="hidden" />

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">
                        Nueva contraseña
                    </label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">
                        Confirmar contraseña
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Restablecer contraseña
                </button>

            </form>

        </div>
    </div>
</div>