@model HikariLegalSRL.Models.DTOs.ClienteDetalleDTO
@using HikariLegalSRL.Models.Enums

@{
    ViewData["Title"] = Model.NombreEmpresaPersona;

    var (badge, texto) = Model.Estado switch
    {
        EstadoCliente.Activo => ("bg-success", "Activo"),
        EstadoCliente.Inactivo => ("bg-secondary", "Inactivo"),
        _ => ("bg-secondary", Model.Estado.ToString())
    };

    var (badgeModalidad, textoModalidad) = Model.ModalidadPago switch
    {
        ModalidadPago.Contado => ("bg-success", "Contado"),
        ModalidadPago.Abono => ("bg-warning text-dark", "Abono"),
        ModalidadPago.ProBono => ("bg-info text-dark", "Pro Bono"),
        _ => ("bg-secondary", Model.ModalidadPago.ToString())
    };

    var puedeEditar = await Authorization.TienePermiso(User, Permisos.Clientes.Editar);
    var puedeDesactivar = await Authorization.TienePermiso(User, Permisos.Clientes.Desactivar);
    var puedeReactivar = await Authorization.TienePermiso(User, Permisos.Clientes.Reactivar);
    var puedeAsignar = await Authorization.TienePermiso(User, Permisos.Clientes.Asignar);
    var esActivo = Model.Estado == EstadoCliente.Activo;
    var esInactivo = Model.Estado == EstadoCliente.Inactivo;
    var responsables = ViewBag.Responsables as List<HikariLegalSRL.Models.DTOs.UsuarioOpcionDTO>
        ?? new List<HikariLegalSRL.Models.DTOs.UsuarioOpcionDTO>();
}

@section Styles {
    <link rel="stylesheet" href="~/css/clientes.css" />
}

<div class="d-flex flex-wrap align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h4 class="mb-0 fw-bold clientes-titulo">@Model.NombreEmpresaPersona</h4>
    <span class="badge @badge">@texto</span>
    <span class="badge @badgeModalidad">@textoModalidad</span>

    <div class="ms-sm-auto d-flex flex-wrap gap-2">
        @if (Model.ProspectoOrigenId is not null)
        {
            <a asp-controller="Prospectos" asp-action="Detalle" asp-route-id="@Model.ProspectoOrigenId"
               class="btn btn-outline-primary btn-sm">
                <i class="bi bi-person-plus me-1"></i>Ver prospecto de origen
            </a>
        }
        @if (esActivo)
        {
            <a asp-action="Editar" asp-route-id="@Model.Id"
               class="btn btn-outline-secondary btn-sm clientes-btn-accion @(puedeEditar ? "" : "disabled")"
               aria-disabled="@(!puedeEditar)"
               tabindex="@(puedeEditar ? "0" : "-1")"
               onclick="@(puedeEditar ? null : "return false;")">
                <i class="bi bi-pencil me-1"></i>Editar
            </a>
            <button type="button" class="btn btn-outline-primary btn-sm clientes-btn-accion" data-bs-toggle="modal"
                    data-bs-target="#modalReasignar" @(puedeAsignar ? null : "disabled")>
                <i class="bi bi-person-gear me-1"></i>Cambiar responsable
            </button>
            <form asp-action="Desactivar" asp-route-id="@Model.Id" method="post"
                  class="form-confirmar"
                  data-titulo="¿Desactivar este cliente?"
                  data-texto="@($"{Model.NombreEmpresaPersona} pasará a estado inactivo. Se conserva el historial.")"
                  data-icono="warning"
                  data-btn-confirmar="Sí, desactivar">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm clientes-btn-accion" @(puedeDesactivar ? null : "disabled")>
                    <i class="bi bi-person-x me-1"></i>Desactivar
                </button>
            </form>
        }
        @if (esInactivo)
        {
            <form asp-action="Reactivar" asp-route-id="@Model.Id" method="post"
                  class="form-confirmar"
                  data-titulo="¿Reactivar este cliente?"
                  data-texto="@($"{Model.NombreEmpresaPersona} volverá a estado activo.")"
                  data-icono="info"
                  data-btn-confirmar="Sí, reactivar">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-success btn-sm clientes-btn-accion" @(puedeReactivar ? null : "disabled")>
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Reactivar
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header fw-semibold clientes-card-header">Información general</div>
            <div class="card-body">
                <dl class="row mb-0 clientes-datos">
                    <dt class="col-5">Contacto</dt>
                    <dd class="col-7">@(Model.NombreContacto ?? "—")</dd>

                    <dt class="col-5">Cédula jurídica</dt>
                    <dd class="col-7">@(Model.CedulaJuridica ?? "—")</dd>

                    <dt class="col-5">Teléfono</dt>
                    <dd class="col-7">@(Model.Telefono ?? "—")</dd>

                    <dt class="col-5">Correo</dt>
                    <dd class="col-7">@Model.Correo</dd>

                    <dt class="col-5">Sector</dt>
                    <dd class="col-7">@(Model.SectorEconomico ?? "—")</dd>

                    <dt class="col-5">Cliente desde</dt>
                    <dd class="col-7">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-5">Responsable</dt>
                    <dd class="col-7">@Model.ResponsableNombre</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-header fw-semibold clientes-card-header">
                Ubicación
                <span class="badge bg-light text-dark border ms-1 text-capitalize">@Model.TipoUbicacion</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0 clientes-datos">
                    <dt class="col-5">País</dt>
                    <dd class="col-7">@Model.Pais</dd>

                    <dt class="col-5">Provincia</dt>
                    <dd class="col-7">@(Model.Provincia ?? "—")</dd>

                    <dt class="col-5">Cantón</dt>
                    <dd class="col-7">@(Model.Canton ?? "—")</dd>

                    <dt class="col-5">Distrito</dt>
                    <dd class="col-7">@(Model.Distrito ?? "—")</dd>

                    <dt class="col-5">Señas exactas</dt>
                    <dd class="col-7">@(string.IsNullOrWhiteSpace(Model.SenasExactas) ? "—" : Model.SenasExactas)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

@if (esActivo && puedeAsignar)
{
    <div class="modal fade" id="modalReasignar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <form asp-action="ReasignarResponsable" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header clientes-card-header">
                        <h5 class="modal-title">Cambiar responsable</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <dl class="row mb-3 clientes-datos">
                            <dt class="col-5">Responsable actual</dt>
                            <dd class="col-7">@Model.ResponsableNombre</dd>
                        </dl>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label fw-semibold" id="labelNuevoResponsable">Nuevo responsable</label>
                                <div class="dropdown clientes-dropdown-responsable">
                                    <button type="button" class="form-select text-start clientes-dropdown-toggle"
                                            id="botonNuevoResponsable" data-bs-toggle="dropdown" aria-expanded="false"
                                            aria-labelledby="labelNuevoResponsable">
                                        <span id="textoNuevoResponsable">-- Seleccione --</span>
                                    </button>
                                    <ul class="dropdown-menu clientes-dropdown-menu w-100" aria-labelledby="botonNuevoResponsable">
                                        @foreach (var r in responsables)
                                        {
                                            <li><a class="dropdown-item" href="#" data-id="@r.Id" data-nombre="@r.Nombre">@r.Nombre</a></li>
                                        }
                                    </ul>
                                    <input type="hidden" id="selectNuevoResponsable" name="ResponsableId"
                                           data-val="true" data-val-required="Debe seleccionar un responsable" />
                                </div>
                                <span class="text-danger small" data-valmsg-for="ResponsableId" data-valmsg-replace="true"></span>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn clientes-btn-guardar">Confirmar cambio</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/clientes-reasignar.js" asp-append-version="true"></script>
}
