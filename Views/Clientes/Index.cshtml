@model HikariLegalSRL.ViewModels.Clientes.ClienteIndexViewModel
@using HikariLegalSRL.Models.Enums

@{
    ViewData["Title"] = "Clientes";
    var puedeEditar = await Authorization.TienePermiso(User, Permisos.Clientes.Editar);
    var puedeDesactivar = await Authorization.TienePermiso(User, Permisos.Clientes.Desactivar);
    var puedeReactivar = await Authorization.TienePermiso(User, Permisos.Clientes.Reactivar);
}

@section Styles {
    <link rel="stylesheet" href="~/css/clientes.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h4 class="mb-0 fw-bold clientes-titulo"><i class="bi bi-people me-2"></i>Clientes</h4>
</div>

<form method="get" class="card shadow-sm border-0 p-3 mb-4 clientes-filtros">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-8">
            <label class="form-label small fw-semibold mb-1">Buscar</label>
            <input name="buscar" value="@Model.Buscar" class="form-control"
                   placeholder="Empresa, contacto o correo..." />
        </div>
        <div class="col-12 col-md-4 d-grid">
            <button type="submit" class="btn btn-outline-secondary">
                <i class="bi bi-search me-1"></i>Filtrar
            </button>
        </div>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 clientes-tabla">
            <thead>
                <tr>
                    <th>Empresa / Persona</th>
                    <th>Contacto</th>
                    <th>Teléfono</th>
                    <th class="text-center">Modalidad</th>
                    <th>Responsable</th>
                    <th class="text-center">Estado</th>
                    <th>Cliente desde</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No hay clientes que coincidan con los filtros.
                        </td>
                    </tr>
                }
                @foreach (var c in Model.Clientes)
                {
                    var (badgeModalidad, textoModalidad) = c.ModalidadPago switch
                    {
                        ModalidadPago.Contado => ("bg-success", "Contado"),
                        ModalidadPago.Abono => ("bg-warning text-dark", "Abono"),
                        ModalidadPago.ProBono => ("bg-info text-dark", "Pro Bono"),
                        _ => ("bg-secondary", c.ModalidadPago.ToString())
                    };
                    var (badgeEstado, textoEstado) = c.Estado switch
                    {
                        EstadoCliente.Activo => ("bg-success", "Activo"),
                        EstadoCliente.Inactivo => ("bg-secondary", "Inactivo"),
                        _ => ("bg-secondary", c.Estado.ToString())
                    };
                    <tr>
                        <td class="fw-semibold">@c.NombreEmpresaPersona</td>
                        <td>
                            @(c.NombreContacto ?? "—")<br />
                            <small class="text-muted">@c.Correo</small>
                        </td>
                        <td>@(c.Telefono ?? "—")</td>
                        <td class="text-center"><span class="badge @badgeModalidad">@textoModalidad</span></td>
                        <td><small>@c.ResponsableNombre</small></td>
                        <td class="text-center"><span class="badge @badgeEstado">@textoEstado</span></td>
                        <td><small>@c.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</small></td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Detalle" asp-route-id="@c.Id"
                               class="btn btn-sm btn-outline-primary" title="Ver detalle">
                                <i class="bi bi-eye"></i>
                            </a>
                            @if (c.Estado == EstadoCliente.Activo)
                            {
                                <a asp-action="Editar" asp-route-id="@c.Id"
                                   class="btn btn-sm btn-outline-secondary clientes-btn-accion @(puedeEditar ? "" : "disabled")"
                                   aria-disabled="@(!puedeEditar)"
                                   tabindex="@(puedeEditar ? "0" : "-1")"
                                   onclick="@(puedeEditar ? null : "return false;")"
                                   title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Desactivar" asp-route-id="@c.Id" method="post"
                                      class="d-inline form-confirmar"
                                      data-titulo="¿Desactivar este cliente?"
                                      data-texto="@($"{c.NombreEmpresaPersona} pasará a estado inactivo. Se conserva el historial.")"
                                      data-icono="warning"
                                      data-btn-confirmar="Sí, desactivar">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger clientes-btn-accion" title="Desactivar" @(puedeDesactivar ? null : "disabled")>
                                        <i class="bi bi-person-x"></i>
                                    </button>
                                </form>
                            }
                            @if (c.Estado == EstadoCliente.Inactivo)
                            {
                                <form asp-action="Reactivar" asp-route-id="@c.Id" method="post"
                                      class="d-inline form-confirmar"
                                      data-titulo="¿Reactivar este cliente?"
                                      data-texto="@($"{c.NombreEmpresaPersona} volverá a estado activo.")"
                                      data-icono="info"
                                      data-btn-confirmar="Sí, reactivar">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-success clientes-btn-accion" title="Reactivar" @(puedeReactivar ? null : "disabled")>
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
