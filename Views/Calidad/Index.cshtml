@model List<HikariLegalSRL.Models.DTOs.EvaluacionCalidadListaDTO>

@{
    ViewData["Title"] = "Evaluaciones de Calidad";
}

@section Styles {
    <link rel="stylesheet" href="~/css/calidad.css" />
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h4 class="mb-0 fw-bold calidad-titulo"><i class="bi bi-star me-2"></i>Evaluaciones de Calidad</h4>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 calidad-tabla">
            <thead>
                <tr>
                    <th>Expediente</th>
                    <th>Cliente</th>
                    <th>Responsable</th>
                    <th class="text-center">Puntuación</th>
                    <th>Comentario</th>
                    <th>Evaluado por</th>
                    <th>Fecha</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            No hay evaluaciones registradas aún.
                        </td>
                    </tr>
                }
                @foreach (var e in Model)
                {
                    <tr>
                        <td class="fw-semibold">
                            <a asp-controller="Expedientes" asp-action="Detalle" asp-route-id="@e.ExpedienteId">#@e.ExpedienteId</a>
                        </td>
                        <td>@e.ClienteNombre</td>
                        <td><small>@e.ResponsableNombre</small></td>
                        <td class="text-center">
                            <span class="calidad-estrellas" title="@e.Puntuacion de 5">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= e.Puntuacion ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </span>
                            <span class="visually-hidden">@e.Puntuacion de 5</span>
                        </td>
                        <td class="calidad-comentario">
                            <small class="text-muted">@(string.IsNullOrWhiteSpace(e.ComentarioResumen) ? "—" : e.ComentarioResumen.TrimEnd() + (e.ComentarioTieneMas ? "…" : ""))</small>
                        </td>
                        <td><small>@e.EvaluadoPorNombre</small></td>
                        <td><small>@e.FechaEvaluacion.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td class="text-end">
                            <a asp-action="Detalle" asp-route-id="@e.EvaluacionId" class="btn btn-sm btn-outline-primary" title="Ver detalle de la evaluación">
                                <i class="bi bi-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
