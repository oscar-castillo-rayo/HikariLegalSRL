@model HikariLegalSRL.ViewModels.Prospectos.ProspectoCreateViewModel

@{
    ViewData["Title"] = "Nuevo prospecto";
}

<div class="d-flex align-items-center gap-2 mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i>
    </a>
    <h2 class="fw-bold mb-0" style="color:#1F3864;">Nuevo prospecto</h2>
</div>

<div class="card shadow-sm" style="max-width:750px;">
    <div class="card-body p-4">
        <form asp-action="Crear" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Prospecto.NombreEmpresaPersona" class="form-label fw-semibold"></label>
                    <input asp-for="Prospecto.NombreEmpresaPersona" class="form-control" />
                    <span asp-validation-for="Prospecto.NombreEmpresaPersona" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Prospecto.NombreContacto" class="form-label fw-semibold"></label>
                    <input asp-for="Prospecto.NombreContacto" class="form-control" />
                    <span asp-validation-for="Prospecto.NombreContacto" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Prospecto.CedulaJuridica" class="form-label fw-semibold"></label>
                    <input asp-for="Prospecto.CedulaJuridica" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Prospecto.Telefono" class="form-label fw-semibold"></label>
                    <input asp-for="Prospecto.Telefono" class="form-control" />
                    <span asp-validation-for="Prospecto.Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Prospecto.Correo" class="form-label fw-semibold"></label>
                    <input asp-for="Prospecto.Correo" type="email" class="form-control" />
                    <span asp-validation-for="Prospecto.Correo" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Prospecto.Sector" class="form-label fw-semibold"></label>
                    <input asp-for="Prospecto.Sector" class="form-control" placeholder="Ej: Tecnología, Comercio, Salud..." />
                </div>

                <div class="col-12"><hr class="my-1" /><small class="text-muted fw-semibold">📍 Ubicación</small></div>

                <div class="col-md-4 form-check ms-2">
                    <input asp-for="EsNacional" class="form-check-input" id="esNacional" checked />
                    <label class="form-check-label" for="esNacional">Dirección nacional (Costa Rica)</label>
                </div>

                <div class="col-12" id="bloqueNacional">
                    <div class="row g-3">
                        <input type="hidden" asp-for="Prospecto.Direccion.PaisId" id="paisIdNacional" />
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Provincia</label>
                            <select id="selectProvincia" class="form-select">
                                <option value="">— Seleccione —</option>
                                @foreach (var p in Model.Provincias)
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Cantón</label>
                            <select id="selectCanton" class="form-select" disabled>
                                <option value="">— Seleccione una provincia —</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Distrito</label>
                            <select asp-for="Prospecto.Direccion.DistritoId" id="selectDistrito" class="form-select" disabled>
                                <option value="">— Seleccione un cantón —</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-6" id="bloqueExtranjero" style="display:none;">
                    <label class="form-label fw-semibold">País</label>
                    <select id="selectPaisExtranjero" class="form-select">
                        <option value="">— Seleccione —</option>
                        @foreach (var pais in Model.Paises)
                        {
                            <option value="@pais.Id">@pais.Nombre</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="Prospecto.Direccion.SenasExactas" class="form-label fw-semibold"></label>
                    <textarea asp-for="Prospecto.Direccion.SenasExactas" class="form-control" rows="2"
                              placeholder="Señas exactas (opcional)..."></textarea>
                </div>

                <div class="col-12"><hr class="my-1" /></div>

                <div class="col-md-4">
                    <label asp-for="Prospecto.Calificacion" class="form-label fw-semibold"></label>
                    <select asp-for="Prospecto.Calificacion" class="form-select">
                        <option value="">— Sin calificar —</option>
                        @for (byte i = 5; i >= 1; i--)
                        {
                            <option value="@i">@i — @string.Concat(Enumerable.Repeat("⭐", i))</option>
                        }
                    </select>
                </div>

                <div class="col-12">
                    <label asp-for="Prospecto.Observaciones" class="form-label fw-semibold"></label>
                    <textarea asp-for="Prospecto.Observaciones" class="form-control" rows="3"
                              placeholder="Observaciones generales del prospecto..."></textarea>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn text-white fw-semibold px-4" style="background:#1F3864;">
                    <i class="bi bi-check-lg me-1"></i>Guardar prospecto
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        const PAIS_COSTA_RICA_ID = 1;

        document.getElementById('esNacional').addEventListener('change', function() {
            const esNacional = this.checked;
            document.getElementById('bloqueNacional').style.display = esNacional ? '' : 'none';
            document.getElementById('bloqueExtranjero').style.display = esNacional ? 'none' : '';
            document.getElementById('paisIdNacional').value = esNacional ? PAIS_COSTA_RICA_ID : '';
        });
        document.getElementById('paisIdNacional').value = PAIS_COSTA_RICA_ID;

        document.getElementById('selectProvincia').addEventListener('change', async function() {
            const provinciaId = this.value;
            const selectCanton = document.getElementById('selectCanton');
            const selectDistrito = document.getElementById('selectDistrito');
            selectCanton.innerHTML = '<option value="">— Seleccione —</option>';
            selectDistrito.innerHTML = '<option value="">— Seleccione un cantón —</option>';
            selectDistrito.disabled = true;
            if (!provinciaId) { selectCanton.disabled = true; return; }

            const respuesta = await fetch(`/Prospectos/ObtenerCantones?provinciaId=${provinciaId}`);
            const cantones = await respuesta.json();
            cantones.forEach(c => {
                const option = document.createElement('option');
                option.value = c.id;
                option.textContent = c.nombre;
                selectCanton.appendChild(option);
            });
            selectCanton.disabled = false;
        });

        document.getElementById('selectCanton').addEventListener('change', async function() {
            const cantonId = this.value;
            const selectDistrito = document.getElementById('selectDistrito');
            selectDistrito.innerHTML = '<option value="">— Seleccione —</option>';
            if (!cantonId) { selectDistrito.disabled = true; return; }

            const respuesta = await fetch(`/Prospectos/ObtenerDistritos?cantonId=${cantonId}`);
            const distritos = await respuesta.json();
            distritos.forEach(d => {
                const option = document.createElement('option');
                option.value = d.id;
                option.textContent = d.nombre;
                selectDistrito.appendChild(option);
            });
            selectDistrito.disabled = false;
        });
    </script>
}